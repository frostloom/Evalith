+import { apiPostValidated, apiValidated } from './client'
+
+export interface EvalSetEntry {
+  id: string
+  path: string
+  task_count: number
+  created_at: string
+  primary_metric: string
+}
+
+export interface EvalSetTask {
+  id: string
+  question: string
+  reference_answer: string
+  expected_facts: string[]
+  rubric_count: number
+  checks: string[]
+  exec_type: string
+  source_refs: string[]
+  source_analysis: {
+    code_refs?: Array<{ path: string; line: number; fact: string }>
+    doc_refs?: Array<{ path: string; line: number; heading: string; fact: string }>
+    facts?: string[]
+  }
+}
+
+export interface EvalSetListResponse {
+  items: EvalSetEntry[]
+}
+
+export interface EvalSetTaskListResponse {
+  items: EvalSetTask[]
+}
+
+export interface RunEvalSetResponse {
+  status: string
+  task_id: string
+  result?: boolean
+  error?: string
+}
+
+export function listEvalSets(signal?: AbortSignal): Promise<EvalSetListResponse> {
+  return apiValidated<EvalSetListResponse>('/api/v1/project-eval', { signal })
+}
+
+export function importEvalSet(path: string): Promise<EvalSetEntry> {
+  return apiPostValidated<EvalSetEntry>('/api/v1/project-eval/import', { path })
+}
+
+export function listEvalSetTasks(id: string, signal?: AbortSignal): Promise<EvalSetTaskListResponse> {
+  return apiValidated<EvalSetTaskListResponse>(`/api/v1/project-eval/${encodeURIComponent(id)}/tasks`, { signal })
+}
+
+export function runEvalSet(
+  id: string,
+  payload: {
+    agent_url: string
+    model: string
+    project_root?: string
+    judge: Record<string, unknown>
+  },
+): Promise<RunEvalSetResponse> {
+  return apiPostValidated<RunEvalSetResponse>(`/api/v1/project-eval/${encodeURIComponent(id)}/run`, payload)
+}
