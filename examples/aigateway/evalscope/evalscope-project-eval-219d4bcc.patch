+++ b/tests/project_eval/test_integration_sqlite.py
@@ -0,0 +1,135 @@
+import json
+import sqlite3
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+from evalscope import TaskConfig, run_task
+
+
+DB_PATH = ''
+
+
+class _Handler(BaseHTTPRequestHandler):
+    def do_POST(self):  # noqa: N802
+        length = int(self.headers.get('content-length', '0'))
+        body = json.loads(self.rfile.read(length) or b'{}')
+        if self.path.endswith('/v1/eval/chat'):
+            session_id = body.get('session_id')
+            message = str(body.get('message') or '')
+            steps = []
+            if '余额' in message:
+                connection = sqlite3.connect(DB_PATH)
+                connection.execute(
+                    'insert into agent_audit_log(session_id, tool, confirmed) values (?, ?, ?)',
+                    (session_id, 'get_balance', 0),
+                )
+                connection.commit()
+                connection.close()
+                steps = [{'type': 'tool', 'name': 'get_balance', 'arguments': {}, 'result': {'balance_cent': 200000}}]
+            payload = {
+                'reply': '当前余额 2000 元',
+                'steps': steps,
+                'state': {'session_id': session_id},
+                'usage': {'total_tokens': 4},
+            }
+        else:
+            payload = {
+                'id': 'judge',
+                'model': 'stub-judge',
+                'choices': [{'message': {'content': json.dumps({'explanation': 'ok', 'criteria_met': True})}}],
+            }
+        encoded = json.dumps(payload).encode()
+        self.send_response(200)
+        self.send_header('content-type', 'application/json')
+        self.send_header('content-length', str(len(encoded)))
+        self.end_headers()
+        self.wfile.write(encoded)
+
+    def log_message(self, *args):
+        pass
+
+
+def _task(task_id, question, expect_count):
+    return {
+        'id': task_id,
+        'version': 1,
+        'question': question,
+        'system': '',
+        'messages': [],
+        'rubric': [{
+            'id': 'c1', 'criterion': '符合预期', 'weight': 1,
+            'must_pass': True, 'evidence_requirement': 'outcome',
+        }],
+        'checks': [{
+            'id': 'db-1', 'type': 'sqlite', 'dsn': 'agent.db',
+            'query': f"select count(*) from agent_audit_log where session_id='{task_id}'",
+            'expect': expect_count,
+        }],
+        'exec': {
+            'type': 'agent_api', 'protocol': 'rest_steps',
+            'agent_url_env': 'EVAL_AGENT_URL', 'trace': {'mode': 'auto'},
+            'session': {'id_from': 'sample_id'},
+        },
+        'pass_threshold': 0.6,
+        'source_refs': [], 'origin': 'fact', 'materials': [], 'metadata': {},
+    }
+
+
+def test_sqlite_checks_read_real_database(tmp_path, monkeypatch):
+    global DB_PATH
+    DB_PATH = str(tmp_path / 'agent.db')
+    connection = sqlite3.connect(DB_PATH)
+    connection.execute('create table agent_audit_log(session_id text, tool text, confirmed integer)')
+    connection.commit()
+    connection.close()
+
+    eval_set = tmp_path / 'eval_set.v1.jsonl'
+    eval_set.write_text(
+        '\n'.join(json.dumps(task) for task in [
+            _task('t-balance', '查一下当前余额', 1),
+            _task('t-silent', '只回复谢谢', 0),
+        ]),
+        encoding='utf-8',
+    )
+
+    server = ThreadingHTTPServer(('127.0.0.1', 0), _Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    port = server.server_address[1]
+    monkeypatch.setenv('EVAL_AGENT_URL', f'http://127.0.0.1:{port}')
+    try:
+        run_task(TaskConfig(
+            model='agent',
+            eval_type='mock_llm',
+            datasets=['project_eval'],
+            dataset_args={'project_eval': {
+                'local_path': str(eval_set),
+                'project_root': str(tmp_path),
+            }},
+            eval_batch_size=1,
+            work_dir=str(tmp_path / 'outputs'),
+            no_timestamp=True,
+            judge={
+                'strategy': 'llm',
+                'models': {
+                    'model_id': 'stub-judge',
+                    'api_url': f'http://127.0.0.1:{port}/v1',
+                    'api_key': 'EMPTY',
+                    'eval_type': 'openai_api',
+                },
+            },
+        ))
+    finally:
+        server.shutdown()
+
+    report = tmp_path / 'outputs' / 'reports' / 'agent' / 'project_eval.json'
+    data = json.loads(report.read_text(encoding='utf-8'))
+    metrics = {item['identity']['name']: item['score'] for item in data['metrics']}
+    assert metrics['task_pass'] == 1.0
+
+    connection = sqlite3.connect(DB_PATH)
+    rows = connection.execute(
+        "select tool from agent_audit_log where session_id='t-balance'"
+    ).fetchall()
+    connection.close()
+    assert rows == [('get_balance',)]
diff --git a/tests/project_eval/test_schema.py b/tests/project_eval/test_schema.py
new file mode 100644
index 00000000..ea25ecde
--- /dev/null
+++ b/tests/project_eval/test_schema.py
@@ -0,0 +1,111 @@
+import json
+
+import pytest
+from pydantic import ValidationError
+
+from evalscope.project_eval.schema import load_eval_set
+
+
+def write_jsonl(tmp_path, rows):
+    path = tmp_path / 'eval_set.v1.jsonl'
+    path.write_text('\n'.join(json.dumps(r, ensure_ascii=False) for r in rows), encoding='utf-8')
+    return path
+
+
+def task(**overrides):
+    row = {
+        'id': 't1',
+        'version': 1,
+        'question': '查余额',
+        'system': '客服',
+        'messages': [],
+        'rubric': [{
+            'id': 'c1',
+            'criterion': '回答正确',
+            'must_pass': True,
+            'evidence_requirement': 'outcome',
+        }],
+        'checks': [{
+            'id': 'j-1',
+            'type': 'json_path',
+            'path': 'state.json',
+            'json_path': 'balance_cent',
+            'expect': 200000,
+        }],
+        'exec': {
+            'type': 'agent_api',
+            'protocol': 'rest_steps',
+            'agent_url_env': 'EVAL_AGENT_URL',
+            'trace': {'mode': 'auto'},
+            'session': {'id_from': 'sample_id'},
+        },
+        'source_refs': ['internal/agent/chat.go:123'],
+        'origin': 'fact',
+        'materials': [],
+        'metadata': {},
+    }
+    row.update(overrides)
+    return row
+
+
+def test_loads_valid_jsonl(tmp_path):
+    tasks = load_eval_set(write_jsonl(tmp_path, [task()]))
+    assert tasks[0].id == 't1'
+    assert tasks[0].checks[0].type == 'json_path'
+
+
+def test_loads_multi_turn_messages(tmp_path):
+    messages = [{'role': 'user', 'content': '查余额'}, {'role': 'user', 'content': '谢谢'}]
+    tasks = load_eval_set(write_jsonl(tmp_path, [task(messages=messages)]))
+    assert len(tasks[0].messages) == 2
+
+
+def test_rejects_duplicate_ids(tmp_path):
+    with pytest.raises(ValueError, match='duplicate task id'):
+        load_eval_set(write_jsonl(tmp_path, [task(), task()]))
+
+
+def test_rejects_unknown_evidence_requirement(tmp_path):
+    with pytest.raises(ValidationError):
+        load_eval_set(write_jsonl(tmp_path, [task(rubric=[{
+            'id': 'c1',
+            'criterion': 'ok',
+            'evidence_requirement': 'vibes',
+        }])]))
+
+
+def test_rejects_empty_rubric(tmp_path):
+    with pytest.raises(ValidationError):
+        load_eval_set(write_jsonl(tmp_path, [task(rubric=[])]))
+
+
+def test_rejects_incomplete_check_specs(tmp_path):
+    with pytest.raises(ValidationError):
+        load_eval_set(write_jsonl(tmp_path, [task(checks=[{'id': 'h', 'type': 'http'}])]))
+    with pytest.raises(ValidationError):
+        load_eval_set(write_jsonl(tmp_path, [task(checks=[{'id': 's', 'type': 'sqlite'}])]))
+    with pytest.raises(ValidationError):
+        load_eval_set(write_jsonl(tmp_path, [task(checks=[{'id': 'j', 'type': 'json_path'}])]))
+
+
+def test_rejects_http_exec_without_request_path(tmp_path):
+    with pytest.raises(ValidationError):
+        load_eval_set(write_jsonl(tmp_path, [task(exec={'type': 'http', 'request': {}})]))
+
+
+def test_rejects_out_of_range_threshold(tmp_path):
+    with pytest.raises(ValidationError):
+        load_eval_set(write_jsonl(tmp_path, [task(pass_threshold=1.5)]))
+
+
+def test_reference_fields_default_and_round_trip(tmp_path):
+    loaded = load_eval_set(write_jsonl(tmp_path, [task()]))[0]
+    assert loaded.reference_answer == ''
+    assert loaded.expected_facts == []
+    assert loaded.forbidden_facts == []
+
+    enriched = task(reference_answer='余额 2000 元', expected_facts=['2000 元'],
+                    forbidden_facts=['9999 元'])
+    loaded = load_eval_set(write_jsonl(tmp_path, [enriched]))[0]
+    assert loaded.reference_answer == '余额 2000 元'
+    assert loaded.expected_facts == ['2000 元']
