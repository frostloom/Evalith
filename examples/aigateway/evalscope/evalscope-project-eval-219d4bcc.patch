new file mode 100644
index 00000000..a5ebfbbf
--- /dev/null
+++ b/evalscope/service/blueprints/project_eval.py
@@ -0,0 +1,208 @@
+"""Optional eval-set import and run API.
+
+This blueprint only consumes externally generated JSONL. It never scans a
+source tree, builds knowledge bases, or generates tasks.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from datetime import datetime
+from pathlib import Path
+
+from flask import Blueprint, current_app, jsonify, request
+
+from evalscope.project_eval.schema import load_eval_set
+from evalscope.utils.logger import get_logger
+
+from ..utils import (
+    OUTPUT_DIR,
+    build_task_info,
+    create_log_file,
+    finish_task,
+    run_eval_wrapper,
+    run_in_subprocess,
+)
+
+logger = get_logger()
+
+bp_project_eval = Blueprint('project_eval', __name__, url_prefix='/api/v1/project-eval')
+
+_REGISTRY_DIR = '.project_eval'
+_REGISTRY_FILE = 'registry.json'
+
+
+def _outputs_root() -> str:
+    return current_app.config.get('OUTPUTS_ROOT') or OUTPUT_DIR
+
+
+def _registry_path() -> str:
+    return os.path.join(_outputs_root(), _REGISTRY_DIR, _REGISTRY_FILE)
+
+
+def _read_registry() -> dict[str, dict]:
+    try:
+        with open(_registry_path(), 'r', encoding='utf-8') as handle:
+            data = json.load(handle)
+    except (OSError, ValueError):
+        return {}
+    return data if isinstance(data, dict) else {}
+
+
+def _write_registry(entries: dict[str, dict]) -> None:
+    path = _registry_path()
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    temporary = f'{path}.tmp'
+    with open(temporary, 'w', encoding='utf-8') as handle:
+        json.dump(entries, handle, ensure_ascii=False, indent=2)
+    os.replace(temporary, path)
+
+
+def _entry_id(path: str) -> str:
+    return hashlib.sha256(path.encode('utf-8')).hexdigest()[:12]
+
+
+def _validate_eval_set_path(path: str) -> str:
+    if not path:
+        raise ValueError('path is required')
+    resolved = os.path.realpath(path)
+    roots = current_app.config.get('EVAL_SET_ROOTS') or []
+    if not roots:
+        raise PermissionError('no eval-set roots configured')
+    if not any(os.path.commonpath([root, resolved]) == root for root in roots):
+        raise PermissionError('path outside eval-set roots')
+    if not os.path.isfile(resolved) or not resolved.endswith('.jsonl'):
+        raise ValueError('path must be a .jsonl file')
+    return resolved
+
+
+def _build_task_config(entry: dict, payload: dict, task_id: str):
+    from evalscope.config import TaskConfig
+
+    agent_url = (payload.get('agent_url') or os.environ.get('EVAL_AGENT_URL') or '').strip()
+    if not agent_url:
+        raise ValueError('agent_url is required')
+    project_root = payload.get('project_root') or str(Path(entry['path']).parent)
+    return TaskConfig(
+        model=payload.get('model') or 'business-agent',
+        eval_type='mock_llm',
+        datasets=['project_eval'],
+        dataset_args={
+            'project_eval': {
+                'local_path': entry['path'],
+                'project_root': project_root,
+                'agent_url': agent_url,
+            }
+        },
+        judge=payload.get('judge') or {},
+        eval_batch_size=1,
+        no_timestamp=True,
+        enable_progress_tracker=True,
+        work_dir=os.path.join(_outputs_root(), task_id),
+    )
+
+
+@bp_project_eval.route('', methods=['GET'])
+def list_eval_sets():
+    entries = sorted(_read_registry().values(), key=lambda item: item.get('created_at', ''), reverse=True)
+    return jsonify({'items': entries})
+
+
+@bp_project_eval.route('/import', methods=['POST'])
+def import_eval_set():
+    payload = request.get_json(silent=True) or {}
+    try:
+        path = _validate_eval_set_path(payload.get('path', ''))
+    except PermissionError as exc:
+        return jsonify({'error': str(exc)}), 403
+    except ValueError as exc:
+        return jsonify({'error': str(exc)}), 422
+
+    try:
+        tasks = load_eval_set(path)
+    except Exception as exc:  # noqa: BLE001 - report validation errors to the caller
+        return jsonify({'error': f'invalid eval set: {exc}'}), 422
+
+    entry_id = _entry_id(path)
+    entry = {
+        'id': entry_id,
+        'path': path,
+        'task_count': len(tasks),
+        'created_at': datetime.now().isoformat(timespec='seconds'),
+        'primary_metric': 'task_pass',
+    }
+    registry = _read_registry()
+    registry[entry_id] = entry
+    _write_registry(registry)
+    return jsonify(entry)
+
+
+@bp_project_eval.route('/<entry_id>/tasks', methods=['GET'])
+def list_tasks(entry_id: str):
+    entry = _read_registry().get(entry_id)
+    if entry is None:
+        return jsonify({'error': 'eval set not found'}), 404
+    try:
+        tasks = load_eval_set(entry['path'])
+    except Exception as exc:  # noqa: BLE001
+        return jsonify({'error': f'invalid eval set: {exc}'}), 422
+    return jsonify({
+        'items': [{
+            'id': task.id,
+            'question': task.question,
+            'reference_answer': task.reference_answer,
+            'expected_facts': task.expected_facts,
+            'rubric_count': len(task.rubric),
+            'checks': [check.type for check in task.checks],
+            'exec_type': task.exec.type,
+            'source_refs': task.source_refs,
+            'source_analysis': task.metadata.get('source_analysis', {}),
+        } for task in tasks]
+    })
+
+
+@bp_project_eval.route('/<entry_id>/run', methods=['POST'])
+def run_eval_set(entry_id: str):
+    entry = _read_registry().get(entry_id)
+    if entry is None:
+        return jsonify({'error': 'eval set not found'}), 404
+
+    payload = request.get_json(silent=True) or {}
+    task_id = f'project_eval_{entry_id}_{datetime.now():%Y%m%d_%H%M%S}'
+    try:
+        task_config = _build_task_config(entry, payload, task_id)
+    except Exception as exc:  # noqa: BLE001 - request validation
+        return jsonify({'error': str(exc)}), 422
+
+    create_log_file(task_id, os.path.join('logs', 'eval_log.log'))
+    task_meta = build_task_info(task_id, 'eval', task_config, None)
+    try:
+        result = run_in_subprocess(run_eval_wrapper, task_config, task_id=task_id, task_meta=task_meta)
+        finish_task(task_id, 'completed')
+        return jsonify({'status': 'completed', 'task_id': task_id, 'result': bool(result)})
+    except Exception as exc:  # noqa: BLE001 - task failures are reported to the caller
+        finish_task(task_id, 'error')
+        logger.error(f'[{task_id}] project eval failed: {exc}')
+        return jsonify({'status': 'error', 'task_id': task_id, 'error': 'Task failed; check the task log'}), 500
+
+
+@bp_project_eval.route('/<entry_id>/runs', methods=['GET'])
+def list_runs(entry_id: str):
+    prefix = f'project_eval_{entry_id}_'
+    runs = []
+    try:
+        names = os.listdir(_outputs_root())
+    except OSError:
+        names = []
+    for name in sorted(names, reverse=True):
+        if not name.startswith(prefix):
+            continue
+        run_dir = os.path.join(_outputs_root(), name)
+        reports = os.path.join(run_dir, 'reports')
+        runs.append({
+            'task_id': name,
+            'has_reports': os.path.isdir(reports),
+        })
+    return jsonify({'items': runs})
