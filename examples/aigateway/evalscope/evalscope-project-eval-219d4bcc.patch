+import json
+
+import pytest
+
+pytest.importorskip('flask')
+
+from evalscope.service.app import create_app
+
+
+def _eval_set(root, task_id='t1'):
+    root.mkdir(parents=True, exist_ok=True)
+    path = root / 'eval_set.v1.jsonl'
+    task = {
+        'id': task_id,
+        'version': 1,
+        'question': '查余额',
+        'system': '客服',
+        'messages': [],
+        'rubric': [{'id': 'c1', 'criterion': '回答正确', 'must_pass': True,
+                    'evidence_requirement': 'answer'}],
+        'checks': [],
+        'exec': {'type': 'agent_api', 'protocol': 'rest_steps',
+                 'agent_url_env': 'EVAL_AGENT_URL', 'trace': {'mode': 'auto'},
+                 'session': {'id_from': 'sample_id'}},
+        'source_refs': [],
+        'origin': 'fact',
+        'materials': [],
+        'metadata': {},
+    }
+    path.write_text(json.dumps(task, ensure_ascii=False), encoding='utf-8')
+    return path
+
+
+def test_feature_hidden_when_disabled(tmp_path):
+    client = create_app(outputs=str(tmp_path / 'outputs')).test_client()
+    assert client.get('/api/v1/project-eval').status_code == 404
+    assert 'project_eval_enabled' not in client.get('/api/v1/config').get_json()
+
+
+def test_config_reports_disabled_flag(tmp_path):
+    client = create_app(outputs=str(tmp_path / 'outputs'), enable_project_eval=False).test_client()
+    assert client.get('/api/v1/config').get_json()['project_eval_enabled'] is False
+
+
+def test_import_rejects_path_outside_roots(tmp_path):
+    root = tmp_path / 'root'
+    root.mkdir()
+    outside = _eval_set(tmp_path / 'outside')
+    app = create_app(
+        outputs=str(tmp_path / 'outputs'),
+        enable_project_eval=True,
+        eval_set_roots=[str(root)],
+    )
+    response = app.test_client().post('/api/v1/project-eval/import', json={'path': str(outside)})
+    assert response.status_code == 403
+
+
+def test_import_and_list(tmp_path):
+    root = tmp_path / 'root'
+    path = _eval_set(root)
+    app = create_app(
+        outputs=str(tmp_path / 'outputs'),
+        enable_project_eval=True,
+        eval_set_roots=[str(root)],
+    )
+    client = app.test_client()
+
+    response = client.post('/api/v1/project-eval/import', json={'path': str(path)})
+    assert response.status_code == 200
+    entry = response.get_json()
+    assert entry['task_count'] == 1
+
+    listing = client.get('/api/v1/project-eval').get_json()
+    assert listing['items'][0]['id'] == entry['id']
+    assert listing['items'][0]['path'] == str(path.resolve())
+
+
+def test_import_rejects_invalid_jsonl(tmp_path):
+    root = tmp_path / 'root'
+    root.mkdir()
+    path = root / 'bad.jsonl'
+    path.write_text('{"id": "t1"}', encoding='utf-8')
+    app = create_app(
+        outputs=str(tmp_path / 'outputs'),
+        enable_project_eval=True,
+        eval_set_roots=[str(root)],
+    )
+    response = app.test_client().post('/api/v1/project-eval/import', json={'path': str(path)})
+    assert response.status_code == 422
+
+
+def test_task_preview_endpoint(tmp_path):
+    root = tmp_path / 'root'
+    path = _eval_set(root)
+    app = create_app(
+        outputs=str(tmp_path / 'outputs'),
+        enable_project_eval=True,
+        eval_set_roots=[str(root)],
+    )
+    client = app.test_client()
+    entry = client.post('/api/v1/project-eval/import', json={'path': str(path)}).get_json()
+    preview = client.get(f"/api/v1/project-eval/{entry['id']}/tasks").get_json()
+    assert preview['items'][0]['id'] == 't1'
+    assert preview['items'][0]['checks'] == []
+    assert preview['items'][0]['exec_type'] == 'agent_api'
+
+
+def test_run_config_does_not_persist_api_keys(tmp_path):
+    root = tmp_path / 'root'
+    path = _eval_set(root)
+    app = create_app(
+        outputs=str(tmp_path / 'outputs'),
+        enable_project_eval=True,
+        eval_set_roots=[str(root)],
+    )
+    client = app.test_client()
+    entry = client.post('/api/v1/project-eval/import', json={'path': str(path)}).get_json()
+    from evalscope.service.blueprints.project_eval import _build_task_config
+
+    with app.app_context():
+        config = _build_task_config(
+            entry,
+            {'agent_url': 'http://127.0.0.1:9201',
+             'judge': {'strategy': 'llm', 'models': {'model_id': 'stub',
+                                                      'api_url': 'http://127.0.0.1:1/v1',
+                                                      'api_key': 'secret'}}},
+            'task-1',
+        )
+    assert 'secret' not in str(config.model_dump())
+    assert config.eval_batch_size == 1
