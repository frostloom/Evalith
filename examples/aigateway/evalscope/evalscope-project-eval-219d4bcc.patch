@@ -0,0 +1,261 @@
+import { useEffect, useState } from 'react'
+import { useLocale } from '@/contexts/LocaleContext'
+import { useAppConfig } from '@/contexts/ReportsContext'
+import {
+  type EvalSetEntry,
+  type EvalSetTask,
+  importEvalSet,
+  listEvalSetTasks,
+  listEvalSets,
+  runEvalSet,
+} from '@/api/evalSets'
+import PathBar from '@/components/ui/PathBar'
+import Button from '@/components/ui/Button'
+import Badge from '@/components/ui/Badge'
+import ErrorAlert from '@/components/ui/ErrorAlert'
+
+const DEFAULT_PROJECT_ROOT = '/Users/bytedance/项目/Evalith/.evalith/aigateway'
+
+export default function EvalSetsPage() {
+  const { t } = useLocale()
+  const { config } = useAppConfig()
+  const [items, setItems] = useState<EvalSetEntry[]>([])
+  const [path, setPath] = useState('')
+  const [selected, setSelected] = useState<EvalSetEntry | null>(null)
+  const [tasks, setTasks] = useState<EvalSetTask[]>([])
+  const [error, setError] = useState('')
+  const [busy, setBusy] = useState(false)
+  const [agentUrl, setAgentUrl] = useState('http://127.0.0.1:9201')
+  const [judgeUrl, setJudgeUrl] = useState('')
+  const [judgeModel, setJudgeModel] = useState('deepseek-flash')
+  const [judgeKey, setJudgeKey] = useState('')
+  const [projectRoot, setProjectRoot] = useState(DEFAULT_PROJECT_ROOT)
+  const [runId, setRunId] = useState('')
+  const [runStatus, setRunStatus] = useState('')
+
+  useEffect(() => {
+    listEvalSets()
+      .then((response) => setItems(response.items))
+      .catch((err: Error) => setError(err.message))
+  }, [])
+
+  async function handleImport() {
+    setError('')
+    setBusy(true)
+    try {
+      const entry = await importEvalSet(path.trim())
+      setItems((current) => [entry, ...current.filter((item) => item.id !== entry.id)])
+      setPath('')
+    } catch (err) {
+      setError((err as Error).message)
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  async function handleSelect(entry: EvalSetEntry) {
+    setSelected(entry)
+    setTasks([])
+    setRunId('')
+    setRunStatus('')
+    try {
+      const response = await listEvalSetTasks(entry.id)
+      setTasks(response.items)
+    } catch (err) {
+      setError((err as Error).message)
+    }
+  }
+
+  async function handleRun() {
+    if (!selected) return
+    setError('')
+    setRunStatus(t('evalSets.running'))
+    setBusy(true)
+    try {
+      const result = await runEvalSet(selected.id, {
+        agent_url: agentUrl.trim(),
+        model: 'business-agent',
+        project_root: projectRoot.trim(),
+        judge: {
+          strategy: 'llm',
+          models: {
+            model_id: judgeModel.trim(),
+            api_url: judgeUrl.trim(),
+            api_key: judgeKey,
+            eval_type: 'openai_api',
+          },
+        },
+      })
+      setRunId(result.task_id)
+      setRunStatus(result.status === 'completed' ? t('evalSets.runSuccess') : t('evalSets.runFailed'))
+    } catch (err) {
+      setError((err as Error).message)
+      setRunStatus(t('evalSets.runFailed'))
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  if (config && config.project_eval_enabled === false) {
+    return (
+      <div className="p-6 max-w-[1200px] mx-auto">
+        <ErrorAlert>Project Eval is disabled. Start the service with --enable-project-eval.</ErrorAlert>
+      </div>
+    )
+  }
+
+  return (
+    <div className="p-6 max-w-[1200px] mx-auto flex flex-col gap-5">
+      <header>
+        <h1 className="text-xl font-bold text-[var(--text)]">{t('evalSets.title')}</h1>
+        <p className="mt-1 text-sm text-[var(--text-muted)]">{t('evalSets.subtitle')}</p>
+      </header>
+
+      {error && <ErrorAlert>{error}</ErrorAlert>}
+
+      <PathBar
+        value={path}
+        onChange={setPath}
+        onSubmit={handleImport}
+        placeholder={t('evalSets.pathPlaceholder')}
+        submitLabel={busy ? t('evalSets.running') : t('evalSets.importLabel')}
+        scanning={busy}
+      />
+
+      <section className="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--bg-card)]">
+        <h2 className="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
+          {t('evalSets.imported')}
+        </h2>
+        {items.length === 0 ? (
+          <p className="px-4 pb-4 text-sm text-[var(--text-muted)]">{t('evalSets.empty')}</p>
+        ) : (
+          <ul className="divide-y divide-[var(--border)]">
+            {items.map((item) => (
+              <li key={item.id}>
+                <button
+                  type="button"
+                  onClick={() => handleSelect(item)}
+                  className={`w-full text-left px-4 py-3 transition-colors hover:bg-[var(--bg-card2)] ${
+                    selected?.id === item.id ? 'bg-[var(--bg-card2)]' : ''
+                  }`}
+                >
+                  <div className="flex items-center justify-between gap-3">
+                    <span className="text-sm font-medium text-[var(--text)] break-words">{item.path}</span>
+                    <Badge>{item.task_count} tasks</Badge>
+                  </div>
+                  <span className="mt-1 block text-xs text-[var(--text-muted)]">
+                    {item.id} · {item.created_at}
+                  </span>
+                </button>
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      {selected ? (
+        <section className="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--bg-card)]">
+          <div className="flex items-center justify-between px-4 py-3 border-b border-[var(--border)]">
+            <h2 className="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
+              {t('evalSets.tasks')} · {selected.task_count}
+            </h2>
+            <Badge>{selected.primary_metric}</Badge>
+          </div>
+          <ul className="divide-y divide-[var(--border)]">
+            {tasks.map((task) => (
+              <li key={task.id} className="px-4 py-3">
+                <div className="flex items-start justify-between gap-3">
+                  <span className="text-sm text-[var(--text)] break-words">{task.question}</span>
+                  <Badge>{task.exec_type}</Badge>
+                </div>
+                <div className="mt-1 text-xs text-[var(--text-muted)]">
+                  {task.rubric_count} {t('evalSets.rubric')} · {task.checks.length} {t('evalSets.checks')}
+                  {task.checks.length > 0 ? ` (${task.checks.join(', ')})` : ''}
+                </div>
+                {task.reference_answer && (
+                  <p className="mt-1 text-xs text-[var(--text-muted)] break-words">
+                    {t('evalSets.referenceAnswer')}: {task.reference_answer}
+                  </p>
+                )}
+                {task.expected_facts.length > 0 && (
+                  <div className="mt-1 flex flex-wrap gap-1">
+                    {task.expected_facts.map((fact) => (
+                      <Badge key={fact} variant="success">{fact}</Badge>
+                    ))}
+                  </div>
+                )}
+                {task.source_refs.length > 0 && (
+                  <p className="mt-1 text-[11px] text-[var(--text-muted)] break-words">
+                    {t('evalSets.sourceRefs')}: {task.source_refs.slice(0, 3).join(' · ')}
+                  </p>
+                )}
+              </li>
+            ))}
+          </ul>
+        </section>
+      ) : (
+        <p className="text-sm text-[var(--text-muted)]">{t('evalSets.selectPrompt')}</p>
+      )}
+
+      {selected && (
+        <section className="rounded-[var(--radius)] border border-[var(--border)] bg-[var(--bg-card)] p-4 flex flex-col gap-3">
+          <div className="grid gap-3 md:grid-cols-2">
+            <label className="flex flex-col gap-1 text-xs text-[var(--text-muted)]">
+              {t('evalSets.agentUrl')}
+              <input
+                className="rounded-[var(--radius-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)]"
+                value={agentUrl}
+                onChange={(event) => setAgentUrl(event.target.value)}
+              />
+            </label>
+            <label className="flex flex-col gap-1 text-xs text-[var(--text-muted)]">
+              {t('evalSets.judgeUrl')}
+              <input
+                className="rounded-[var(--radius-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)]"
+                value={judgeUrl}
+                onChange={(event) => setJudgeUrl(event.target.value)}
+              />
+            </label>
+            <label className="flex flex-col gap-1 text-xs text-[var(--text-muted)]">
+              {t('evalSets.projectRoot')}
+              <input
+                className="rounded-[var(--radius-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)]"
+                value={projectRoot}
+                onChange={(event) => setProjectRoot(event.target.value)}
+              />
+            </label>
+            <label className="flex flex-col gap-1 text-xs text-[var(--text-muted)]">
+              {t('evalSets.judgeModel')}
+              <input
+                className="rounded-[var(--radius-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)]"
+                value={judgeModel}
+                onChange={(event) => setJudgeModel(event.target.value)}
+              />
+            </label>
+            <label className="flex flex-col gap-1 text-xs text-[var(--text-muted)]">
+              {t('evalSets.judgeKey')}
+              <input
+                type="password"
+                autoComplete="off"
+                className="rounded-[var(--radius-sm)] border border-[var(--border)] bg-[var(--bg)] px-3 py-2 text-sm text-[var(--text)]"
+                value={judgeKey}
+                onChange={(event) => setJudgeKey(event.target.value)}
+              />
+            </label>
+          </div>
+          <div className="flex items-center gap-3">
+            <Button onClick={handleRun} disabled={busy || !agentUrl.trim() || !judgeUrl.trim()}>
+              {busy ? t('evalSets.running') : t('evalSets.run')}
+            </Button>
+            {runStatus && <span className="text-sm text-[var(--text-muted)]">{runStatus}</span>}
+            {runId && (
+              <a className="text-sm text-[var(--accent)] hover:underline" href={`/reports?search=${encodeURIComponent(runId)}`}>
+                {t('evalSets.taskId')}: {runId} · {t('evalSets.viewReport')}
+              </a>
+            )}
+          </div>
+        </section>
+      )}
+    </div>
+  )
+}
