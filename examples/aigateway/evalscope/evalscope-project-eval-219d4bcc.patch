@@ -0,0 +1,74 @@
+import Badge from '@/components/ui/Badge'
+import { useLocale } from '@/contexts/LocaleContext'
+
+export interface Verdict {
+  criterion_id: string
+  verdict: boolean
+  reason?: string
+  evidence_refs?: Array<{ type: string; step?: number; event?: string; id?: string }>
+}
+
+export interface CheckEvidence {
+  check_id: string
+  ok: boolean
+  error?: string | null
+}
+
+export default function RubricEvidencePanel({
+  verdicts,
+  checks,
+}: {
+  verdicts?: Verdict[]
+  checks?: CheckEvidence[]
+}) {
+  const { t } = useLocale()
+  if (!verdicts || verdicts.length === 0) return null
+  return (
+    <div className="border-t border-[var(--border)] px-4 py-3">
+      <div className="type-label-xs mb-2">{t('evalSets.rubricEvidence')}</div>
+      <ul className="flex flex-col gap-2">
+        {verdicts.map((verdict) => (
+          <li key={verdict.criterion_id} className="rounded-[var(--radius-sm)] border border-[var(--border)] p-2">
+            <div className="flex items-center gap-2">
+              <Badge variant={verdict.verdict ? 'success' : 'danger'}>
+                {verdict.verdict ? t('evalSets.verdictMet') : t('evalSets.verdictMissed')}
+              </Badge>
+              <span className="text-sm text-[var(--text)] break-words">{verdict.criterion_id}</span>
+            </div>
+            {verdict.reason && (
+              <p className="mt-1 text-xs text-[var(--text-muted)] break-words">{verdict.reason}</p>
+            )}
+            {verdict.evidence_refs && verdict.evidence_refs.length > 0 && (
+              <div className="mt-1 flex flex-wrap gap-1">
+                {verdict.evidence_refs.map((ref, index) => (
+                  <span
+                    key={`${verdict.criterion_id}-${index}`}
+                    className="rounded-[var(--radius-sm)] bg-[var(--bg-card2)] px-2 py-0.5 text-[11px] text-[var(--text-muted)]"
+                  >
+                    {ref.type === 'trace' ? `${ref.type} step ${ref.step} ${ref.event}` : `${ref.type} ${ref.id}`}
+                  </span>
+                ))}
+              </div>
+            )}
+          </li>
+        ))}
+      </ul>
+      {checks && checks.length > 0 && (
+        <div className="mt-2">
+          <div className="type-label-xs mb-1">{t('evalSets.checksEvidence')}</div>
+          <ul className="flex flex-col gap-1">
+            {checks.map((check) => (
+              <li key={check.check_id} className="flex items-center gap-2 text-xs">
+                <Badge variant={check.ok ? 'success' : 'danger'}>{check.ok ? 'ok' : 'fail'}</Badge>
+                <span className="text-[var(--text-muted)] break-words">
+                  {check.check_id}
+                  {check.error ? `: ${check.error}` : ''}
+                </span>
+              </li>
+            ))}
+          </ul>
+        </div>
+      )}
+    </div>
+  )
+}
