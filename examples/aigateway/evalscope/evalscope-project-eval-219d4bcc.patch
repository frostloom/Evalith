+++ b/examples/project_eval/run_demo.py
@@ -0,0 +1,117 @@
+"""Run the curated ai-gateway eval set against the synthetic wrapper.
+
+The wrapper must already be running. Use:
+
+    # L2 (with trace)
+    EVAL_AGENT_TRACE_MODE=l2 .evalith/bin/ai-gateway-adapter
+
+    # L0 (no trace)
+    EVAL_AGENT_TRACE_MODE=l0 .evalith/bin/ai-gateway-adapter
+
+Then:
+
+    python examples/project_eval/run_demo.py --mode l2 \
+      --judge-url http://127.0.0.1:9301/v1 --judge-key EMPTY
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import urllib.request
+from pathlib import Path
+
+from evalscope import TaskConfig, run_task
+from evalscope.project_eval.schema import load_eval_set
+
+DEFAULT_EVAL_SET = str(
+    Path(__file__).resolve().parents[2].parent / 'Evalith' / 'examples' / 'aigateway' / 'evalscope' / 'eval_set.v1.jsonl'
+)
+DEFAULT_AGENT_URL = 'http://127.0.0.1:9201'
+DEFAULT_STATE_DIR = str(
+    Path(__file__).resolve().parents[2].parent / 'Evalith' / '.evalith' / 'aigateway'
+)
+
+
+def check_wrapper(agent_url: str, mode: str) -> None:
+    with urllib.request.urlopen(f'{agent_url}/health', timeout=5) as response:
+        health = json.loads(response.read())
+    if health.get('trace_mode') != mode:
+        raise SystemExit(
+            f'wrapper trace_mode={health.get("trace_mode")!r}, expected {mode!r}; '
+            'restart the wrapper with EVAL_AGENT_TRACE_MODE=' + mode
+        )
+    request = urllib.request.Request(f'{agent_url}/v1/eval/reset', method='POST')
+    urllib.request.urlopen(request, timeout=5).read()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--mode', choices=['l2', 'l0'], default='l2')
+    parser.add_argument('--eval-set', default=DEFAULT_EVAL_SET)
+    parser.add_argument('--agent-url', default=DEFAULT_AGENT_URL)
+    parser.add_argument('--state-dir', default=DEFAULT_STATE_DIR,
+                        help='Wrapper EVAL_AGENT_STATE_DIR containing agent.db')
+    parser.add_argument('--judge-url', required=True)
+    parser.add_argument('--judge-model', default='deepseek-flash')
+    parser.add_argument('--judge-key', default=os.environ.get('DEEPSEEK_API_KEY', 'EMPTY'))
+    parser.add_argument('--work-dir', default=None)
+    args = parser.parse_args()
+
+    eval_set = Path(args.eval_set)
+    if not eval_set.is_file():
+        raise SystemExit(f'eval set not found: {eval_set}')
+    tasks = load_eval_set(eval_set)
+    check_wrapper(args.agent_url, args.mode)
+    db_path = Path(args.state_dir) / 'agent.db'
+    if not db_path.is_file():
+        raise SystemExit(
+            f'agent.db not found under {args.state_dir}; start the wrapper with '
+            f'EVAL_AGENT_STATE_DIR={args.state_dir}'
+        )
+
+    work_dir = args.work_dir or str(Path('outputs') / f'demo-aigateway-{args.mode}')
+    config = TaskConfig(
+        model='ai-gateway-cs',
+        eval_type='mock_llm',
+        datasets=['project_eval'],
+        dataset_args={
+            'project_eval': {
+                'local_path': str(eval_set),
+                'project_root': args.state_dir,
+                'agent_url': args.agent_url,
+            }
+        },
+        judge={
+            'strategy': 'llm',
+            'models': {
+                'model_id': args.judge_model,
+                'api_url': args.judge_url,
+                'api_key': args.judge_key,
+                'eval_type': 'openai_api',
+            },
+        },
+        eval_batch_size=1,
+        work_dir=work_dir,
+        no_timestamp=True,
+    )
+    os.environ['EVAL_AGENT_URL'] = args.agent_url
+    run_task(config)
+
+    report = Path(work_dir) / 'reports' / 'ai-gateway-cs' / 'project_eval.json'
+    if not report.is_file():
+        raise SystemExit(f'report not found: {report}')
+    data = json.loads(report.read_text(encoding='utf-8'))
+    metrics = {item['identity']['name']: item['score'] for item in data['metrics']}
+    print(f"tasks={len(tasks)} task_pass={metrics.get('task_pass')} "
+          f"rubric_score={metrics.get('rubric_score')} "
+          f"evidence_coverage={metrics.get('evidence_coverage')}")
+    print(f'report={report}')
+    if args.mode == 'l0' and metrics.get('evidence_coverage') == 1.0:
+        raise SystemExit('L0 run unexpectedly reported full evidence coverage')
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
